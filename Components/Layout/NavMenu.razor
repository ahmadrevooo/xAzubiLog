@using xAzubiLog.Services
@using Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage

@inject ProtectedSessionStorage SessionStorage
@inject AuthService Auth
@inject NavigationManager Nav


<nav class="py-4 px-4 px-md-5" style="background-color: transparent;">
    <div class="d-flex justify-content-between align-items-center w-100">

        <a class="d-flex align-items-center text-white text-decoration-none" href="" style="padding: 0;">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="me-3" style="display: block;">
                <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20" />
                <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z" />
                <line x1="10" y1="6" x2="16" y2="6" />
                <line x1="10" y1="10" x2="16" y2="10" />
            </svg>
            <span class="fw-medium" style="font-size: 1.2rem; letter-spacing: 0.5px; line-height: 1;">AzubiLog</span>
        </a>

        <div class="d-none d-lg-flex align-items-center justify-content-center">
            <div style="display: flex; align-items: center; gap: 3rem; margin: 0; padding: 0;">
                <div class="sqs-nav-item">
                    <a href="entries" class="sqs-nav-link">
                        <span style="line-height: 1;">Einträge</span>
                        <span class="sqs-chevron-wrapper">
                            <svg class="sqs-chevron" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"></polyline></svg>
                        </span>
                    </a>
                    <div class="sqs-dropdown-menu">
                        <div class="p-4">
                            <span class="d-block mb-3 text-uppercase" style="color: #666; font-size: 0.75rem; letter-spacing: 1px;">Übersicht</span>
                            <a href="entries" class="sqs-dropdown-link">Alle Einträge</a>
                            <a href="#" class="sqs-dropdown-link">Fehlende Einträge</a>
                        </div>
                    </div>
                </div>

                <div class="sqs-nav-item">
                    <a href="weekly" class="sqs-nav-link">
                        <span style="line-height: 1;">Wochenbericht</span>
                        <span class="sqs-chevron-wrapper">
                            <svg class="sqs-chevron" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"></polyline></svg>
                        </span>
                    </a>
                    <div class="sqs-dropdown-menu">
                        <div class="p-4">
                            <span class="d-block mb-3 text-uppercase" style="color: #666; font-size: 0.75rem; letter-spacing: 1px;">Aktionen</span>
                            <a href="weekly" class="sqs-dropdown-link">Zur Übersicht</a>
                            <a href="#" class="sqs-dropdown-link">Als PDF exportieren</a>
                        </div>
                    </div>
                </div>

                <div class="sqs-nav-item">
                 
                </div>
            </div>
        </div>

        <div class="d-none d-lg-flex align-items-center">
            @if (Auth.IsAuthenticated)
            {
                <div class="profile-menu">
                    <div class="profile-avatar">
                        @Auth.CurrentUser!.Vorname[0]@Auth.CurrentUser!.Nachname[0]
                    </div>
                    <div class="profile-dropdown">
                        <div class="profile-name">@Auth.CurrentUser!.Vorname @Auth.CurrentUser!.Nachname</div>
                        <div class="profile-role">@Auth.CurrentUser!.Rolle</div>
                        <hr style="border-color:#1f1f1f; margin: 0.5rem 0;" />
                        <a href="/konto" class="profile-logout" style="color:white;">Konto bearbeiten</a>
                        <button class="profile-logout" @onclick="DoLogout">Abmelden</button>
                    </div>
                </div>
            }
            else
            {
                <a href="/login" class="text-white text-decoration-none fw-medium" style="letter-spacing: 0.5px; opacity: 0.85; transition: opacity 0.2s;">Anmelden</a>
            }
        </div>

    </div>
</nav>

<style>
    .sqs-nav-item {
        position: relative;
        padding: 20px 0;
        margin: -20px 0;
    }

    .sqs-nav-link {
        display: flex;
        align-items: center;
        gap: 6px;
        color: #ffffff;
        text-decoration: none;
        opacity: 0.85;
        transition: opacity 0.2s ease;
        cursor: pointer;
    }

    .sqs-nav-item:hover .sqs-nav-link { opacity: 1; }

    .sqs-chevron-wrapper {
        display: flex;
        align-items: center;
        transform: translateY(1px);
    }

    .sqs-chevron {
        transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .sqs-nav-item:hover .sqs-chevron { transform: rotate(180deg); }

    .sqs-dropdown-menu {
        position: absolute;
        top: 100%;
        left: 50%;
        transform: translateX(-50%) translateY(10px);
        background-color: #0a0a0a;
        border: 1px solid #1f1f1f;
        border-radius: 8px;
        min-width: 240px;
        box-shadow: 0 20px 40px rgba(0,0,0,0.5);
        visibility: hidden;
        opacity: 0;
        pointer-events: none;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        z-index: 1000;
    }

    .sqs-dropdown-menu::before {
        content: '';
        position: absolute;
        top: -20px;
        left: 0;
        width: 100%;
        height: 20px;
    }

    .sqs-nav-item:hover .sqs-dropdown-menu {
        visibility: visible;
        opacity: 1;
        transform: translateX(-50%) translateY(0);
        pointer-events: auto;
    }

    .sqs-dropdown-link {
        display: block;
        color: #ffffff;
        text-decoration: none;
        padding: 8px 0;
        opacity: 0.6;
        transition: opacity 0.2s ease, transform 0.2s ease;
    }

    .sqs-dropdown-link:hover {
        opacity: 1;
        transform: translateX(4px);
    }

    .profile-menu {
        position: relative;
        padding: 10px 0;
        margin: -10px 0;
        cursor: pointer;
    }

    .profile-avatar {
        width: 38px;
        height: 38px;
        border-radius: 50%;
        background: linear-gradient(135deg, #00ff75, #3700ff);
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
        font-size: 0.85rem;
        color: white;
        letter-spacing: 0.5px;
    }

    .profile-dropdown {
        position: absolute;
        top: 100%;
        right: 0;
        background-color: #0a0a0a;
        border: 1px solid #1f1f1f;
        border-radius: 8px;
        min-width: 200px;
        padding: 1rem;
        box-shadow: 0 20px 40px rgba(0,0,0,0.5);
        visibility: hidden;
        opacity: 0;
        pointer-events: none;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        z-index: 1000;
    }

    .profile-menu:hover .profile-dropdown {
        visibility: visible;
        opacity: 1;
        pointer-events: auto;
    }

    .profile-name {
        color: white;
        font-weight: 600;
        font-size: 0.9rem;
    }

    .profile-role {
        color: #666;
        font-size: 0.8rem;
        margin-top: 2px;
    }

    .profile-logout {
        display: block;
        color: #ff6b6b;
        text-decoration: none;
        font-size: 0.85rem;
        margin-top: 0.5rem;
        transition: opacity 0.2s;
    }

    .profile-logout:hover { opacity: 0.7; }
</style>

@code {
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !Auth.IsAuthenticated)
        {
            try
            {
                var result = await SessionStorage.GetAsync<int>("userId");

                if (result.Success && result.Value != 0)
                {
                    await Auth.RestoreSessionAsync(result.Value);
                    StateHasChanged();
                }
            }
            catch
            {
                // optional logging
            }
        }
    }

    private async Task DoLogout()
    {
        // 1. Session löschen
        await SessionStorage.DeleteAsync("userId");

        // 2. Auth zurücksetzen
        Auth.Logout();

        // 3. Redirect auf Login
        Nav.NavigateTo("/login", true);
    }

    protected override void OnInitialized()
{
    Auth.OnChange += StateHasChanged;
}

public void Dispose()
{
    Auth.OnChange -= StateHasChanged;
}
}