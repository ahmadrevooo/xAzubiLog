@inject xAzubiLog.Services.AuthService Auth
@inject NavigationManager Nav

<nav class="py-4 px-4 px-md-5" style="background-color: transparent;">
    <div class="d-flex justify-content-between align-items-center w-100">

        <!-- LOGO -->
        <a class="d-flex align-items-center text-white text-decoration-none" href="">
            <span class="fw-medium" style="font-size: 1.2rem;">AzubiLog</span>
        </a>

        <!-- NAV LINKS -->
        <div class="d-none d-lg-flex align-items-center justify-content-center">
            <div style="display: flex; gap: 3rem;">
                <a href="BerichtEintraeges/create" class="sqs-nav-link">Einträge</a>
                <a href="weekly" class="sqs-nav-link">Wochenbericht</a>
                <a href="create" class="sqs-nav-link">Eintrag erstellen</a>
            </div>
        </div>

        <!-- RIGHT SIDE -->
        <div class="d-none d-lg-flex align-items-center gap-3">
            @if (Auth.IsAuthenticated && Auth.CurrentUser != null)
            {
                <div class="profile-menu">
                    <div class="profile-avatar">
                        @Auth.CurrentUser.Vorname[0]@Auth.CurrentUser.Nachname[0]
                    </div>
                    <div class="profile-dropdown">
                        <div class="profile-name">@Auth.CurrentUser.Vorname @Auth.CurrentUser.Nachname</div>
                        <div class="profile-role">@Auth.CurrentUser.Rolle</div>
                        <hr style="border-color: #1f1f1f; margin: 0.5rem 0;" />
                        <a href="/konto" class="sqs-dropdown-link">Mein Konto</a>
                        <a href="/logout" class="profile-logout">Abmelden</a>
                    </div>
                </div>
            }
            else
            {
                <a href="/login" class="login-link">Anmelden</a>
            }
        </div>

    </div>
</nav>

<style>
    .sqs-nav-link {
        color: white;
        text-decoration: none;
        opacity: 0.85;
        transition: opacity 0.2s;
    }

    .sqs-nav-link:hover {
        opacity: 1;
    }

    .login-link {
        color: white;
        text-decoration: none;
        opacity: 0.85;
        transition: opacity 0.2s;
    }

    .login-link:hover {
        opacity: 1;
    }

    .profile-menu {
        position: relative;
        cursor: pointer;
        padding: 10px 0;
        margin: -10px 0;
    }

    .profile-avatar {
        width: 38px;
        height: 38px;
        border-radius: 50%;
        background: linear-gradient(135deg, #00ff75, #3700ff);
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
        font-size: 0.85rem;
        color: white;
        letter-spacing: 0.5px;
    }

    .profile-dropdown {
        position: absolute;
        top: 100%;
        right: 0;
        margin-top: 10px;
        background: #0a0a0a;
        border: 1px solid #1f1f1f;
        border-radius: 8px;
        padding: 1rem;
        min-width: 200px;
        box-shadow: 0 20px 40px rgba(0,0,0,0.5);
        visibility: hidden;
        opacity: 0;
        pointer-events: none;
        transition: all 0.2s ease;
        z-index: 1000;
    }

    .profile-menu:hover .profile-dropdown {
        visibility: visible;
        opacity: 1;
        pointer-events: auto;
    }

    .profile-name {
        color: white;
        font-weight: 600;
        font-size: 0.9rem;
    }

    .profile-role {
        font-size: 0.8rem;
        color: #666;
        margin-top: 2px;
    }

    .sqs-dropdown-link {
        display: block;
        color: white;
        text-decoration: none;
        padding: 6px 0;
        opacity: 0.7;
        font-size: 0.9rem;
        transition: opacity 0.2s;
    }

    .sqs-dropdown-link:hover {
        opacity: 1;
    }

    .profile-logout {
        display: block;
        color: #ff6b6b;
        text-decoration: none;
        font-size: 0.85rem;
        margin-top: 4px;
        transition: opacity 0.2s;
    }

    .profile-logout:hover {
        opacity: 0.7;
    }
</style>