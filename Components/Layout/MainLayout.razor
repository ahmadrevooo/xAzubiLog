@inherits LayoutComponentBase


<div>
    <NavMenu />

    <main>
        @Body
    </main>
</div>

@code {
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await Theme.InitializeAsync(false);
            await JS.InvokeVoidAsync("setTheme", Theme.IsDark);

            StateHasChanged();
        }
    }
}