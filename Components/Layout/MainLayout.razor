@inherits LayoutComponentBase

<div class="page d-flex flex-column" style="min-height: 100vh; background-color: #000000; color: #ffffff;">

    <!-- Top Navigation -->
    <header class="border-bottom" style="border-color: #222 !important;">
        <NavMenu />
    </header>

    <!-- Main Content Area -->
    <main class="flex-grow-1">
        <article class="content">
            @Body
        </article>
    </main>

    <footer class="border-top py-4 mt-auto" style="border-color: #222 !important;">
        <div class="container px-4 text-center text-muted small">
            xAzubiLog &copy; 2026
        </div>
    </footer>
</div>