@page "/logout"
@rendermode InteractiveServer

@inject xAzubiLog.Services.AuthService Auth
@inject NavigationManager Nav
@inject Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage.ProtectedSessionStorage SessionStorage

protected override async Task OnAfterRenderAsync(bool firstRender)
{
    if (firstRender)
    {
        await SessionStorage.DeleteAsync("userId");
        Auth.Logout();
        Nav.NavigateTo("/login", true);
    }
}

<p>Du wirst abgemeldet...</p>

@code {
    protected override void OnInitialized()
    {
        // ✅ User wirklich ausloggen
        Auth.Logout();

        // ✅ Redirect zum Login
        Nav.NavigateTo("/login", true);
    }
}