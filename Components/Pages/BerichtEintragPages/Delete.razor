@page "/BerichtEintraeges/delete"
@using Microsoft.EntityFrameworkCore
@using xAzubiLog.Models
@inject IDbContextFactory<xAzubiLog.Data.xAzubiLogContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Delete</PageTitle>

<h1>Delete</h1>

<p>Are you sure you want to delete this?</p>
<div>
    <h2>BerichtEintraege</h2>
    <hr />
    @if (BerichtEintraege is null)
    {
        <p><em>Loading...</em></p>
    }
    else {
        <dl class="row">
            <dt class="col-sm-2">BenutzerId</dt>
            <dd class="col-sm-10">@BerichtEintraege.BenutzerId</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">AusbilderId</dt>
            <dd class="col-sm-10">@BerichtEintraege.AusbilderId</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">KategorieId</dt>
            <dd class="col-sm-10">@BerichtEintraege.KategorieId</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">WochenberichtId</dt>
            <dd class="col-sm-10">@BerichtEintraege.WochenberichtId</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">Datum</dt>
            <dd class="col-sm-10">@BerichtEintraege.Datum</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">Tagestyp</dt>
            <dd class="col-sm-10">@BerichtEintraege.Tagestyp</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">Auftragsnummer</dt>
            <dd class="col-sm-10">@BerichtEintraege.Auftragsnummer</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">Titel</dt>
            <dd class="col-sm-10">@BerichtEintraege.Titel</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">Beschreibung</dt>
            <dd class="col-sm-10">@BerichtEintraege.Beschreibung</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">Notiz</dt>
            <dd class="col-sm-10">@BerichtEintraege.Notiz</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">Fach</dt>
            <dd class="col-sm-10">@BerichtEintraege.Fach</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">Startzeit</dt>
            <dd class="col-sm-10">@BerichtEintraege.Startzeit</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">Endzeit</dt>
            <dd class="col-sm-10">@BerichtEintraege.Endzeit</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">Dauer</dt>
            <dd class="col-sm-10">@BerichtEintraege.Dauer</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">Status</dt>
            <dd class="col-sm-10">@BerichtEintraege.Status</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">ErstelltAm</dt>
            <dd class="col-sm-10">@BerichtEintraege.ErstelltAm</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">GeändertAm</dt>
            <dd class="col-sm-10">@BerichtEintraege.GeändertAm</dd>
        </dl>
        <EditForm method="post" Model="BerichtEintraege" OnValidSubmit="DeleteBerichtEintraege" FormName="delete" Enhance>
            <button type="submit" class="btn btn-danger" disabled="@(BerichtEintraege is null)">Delete</button> |
            <a href="/BerichtEintraeges">Back to List</a>
        </EditForm>
    }
</div>

@code {
    private BerichtEintraege? BerichtEintraege;

    [SupplyParameterFromQuery]
    private int Id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        BerichtEintraege = await context.BerichtEintrag.FirstOrDefaultAsync(m => m.Id == Id);

        if (BerichtEintraege is null)
        {
            NavigationManager.NotFound();
        }
    }

    private async Task DeleteBerichtEintraege()
    {
        using var context = DbFactory.CreateDbContext();
        context.BerichtEintrag.Remove(BerichtEintraege!);
        await context.SaveChangesAsync();
        NavigationManager.NavigateTo("/BerichtEintraeges");
    }
}
