                </div>
                <div class="mb-3">
                    <label for="ausbilderid" class="form-label">AusbilderId:</label>
                    <InputNumber id="ausbilderid" @bind-Value="BerichtEintraege.AusbilderId" class="form-control" />
                    <ValidationMessage For="() => BerichtEintraege.AusbilderId" class="text-danger" />
                </div>
                <div class="mb-3">
                    <label for="kategorieid" class="form-label">KategorieId:</label>
                    <InputNumber id="kategorieid" @bind-Value="BerichtEintraege.KategorieId" class="form-control" />
                    <ValidationMessage For="() => BerichtEintraege.KategorieId" class="text-danger" />
                </div>
                <div class="mb-3">
                    <label for="wochenberichtid" class="form-label">WochenberichtId:</label>
                    <InputNumber id="wochenberichtid" @bind-Value="BerichtEintraege.WochenberichtId" class="form-control" />
                    <ValidationMessage For="() => BerichtEintraege.WochenberichtId" class="text-danger" />
                </div>
                <div class="mb-3">
                    <label for="datum" class="form-label">Datum:</label>
                    <InputDate id="datum" @bind-Value="BerichtEintraege.Datum" class="form-control" />
                    <ValidationMessage For="() => BerichtEintraege.Datum" class="text-danger" />
                </div>
                <div class="mb-3">
                    <label for="tagestyp" class="form-label">Tagestyp:</label>
                    <InputText id="tagestyp" @bind-Value="BerichtEintraege.Tagestyp" class="form-control" />
                    <ValidationMessage For="() => BerichtEintraege.Tagestyp" class="text-danger" />
                </div>
                <div class="mb-3">
                    <label for="auftragsnummer" class="form-label">Auftragsnummer:</label>
                    <InputText id="auftragsnummer" @bind-Value="BerichtEintraege.Auftragsnummer" class="form-control" />
                    <ValidationMessage For="() => BerichtEintraege.Auftragsnummer" class="text-danger" />
                </div>
                <div class="mb-3">
                    <label for="titel" class="form-label">Titel:</label>
                    <InputText id="titel" @bind-Value="BerichtEintraege.Titel" class="form-control" />
                    <ValidationMessage For="() => BerichtEintraege.Titel" class="text-danger" />
                </div>
                <div class="mb-3">
                    <label for="beschreibung" class="form-label">Beschreibung:</label>
                    <InputText id="beschreibung" @bind-Value="BerichtEintraege.Beschreibung" class="form-control" />
                    <ValidationMessage For="() => BerichtEintraege.Beschreibung" class="text-danger" />
                </div>
                <div class="mb-3">
                    <label for="notiz" class="form-label">Notiz:</label>
                    <InputText id="notiz" @bind-Value="BerichtEintraege.Notiz" class="form-control" />
                    <ValidationMessage For="() => BerichtEintraege.Notiz" class="text-danger" />
                </div>
                <div class="mb-3">
                    <label for="fach" class="form-label">Fach:</label>
                    <InputText id="fach" @bind-Value="BerichtEintraege.Fach" class="form-control" />
                    <ValidationMessage For="() => BerichtEintraege.Fach" class="text-danger" />
                </div>
                <div class="mb-3">
                    <label for="startzeit" class="form-label">Startzeit:</label>
                    <InputDate id="startzeit" @bind-Value="BerichtEintraege.Startzeit" class="form-control" />
                    <ValidationMessage For="() => BerichtEintraege.Startzeit" class="text-danger" />
                </div>
                <div class="mb-3">
                    <label for="endzeit" class="form-label">Endzeit:</label>
                    <InputDate id="endzeit" @bind-Value="BerichtEintraege.Endzeit" class="form-control" />
                    <ValidationMessage For="() => BerichtEintraege.Endzeit" class="text-danger" />
                </div>
                <div class="mb-3">
                    <label for="dauer" class="form-label">Dauer:</label>
                    <InputNumber id="dauer" @bind-Value="BerichtEintraege.Dauer" class="form-control" />
                    <ValidationMessage For="() => BerichtEintraege.Dauer" class="text-danger" />
                </div>
                <div class="mb-3">
                    <label for="status" class="form-label">Status:</label>
                    <InputText id="status" @bind-Value="BerichtEintraege.Status" class="form-control" />
