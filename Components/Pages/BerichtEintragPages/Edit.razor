<div>
    <a href="/BerichtEintraeges">Back to List</a>
</div>

@code {
    [SupplyParameterFromQuery]
    private int Id { get; set; }

    [SupplyParameterFromForm]
    private BerichtEintrag? BerichtEintraege { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        BerichtEintraege ??= await context.BerichtEintrag.FirstOrDefaultAsync(m => m.Id == Id);

        if (BerichtEintraege is null)
        {
            NavigationManager.NotFound();
        }
    }

    // To protect from overposting attacks, enable the specific properties you want to bind to.
    // For more information, see https://learn.microsoft.com/aspnet/core/blazor/forms/#mitigate-overposting-attacks.
    private async Task UpdateBerichtEintraege()
    {
        using var context = DbFactory.CreateDbContext();
        context.Attach(BerichtEintraege!).State = EntityState.Modified;

        try
        {
            await context.SaveChangesAsync();
        }
        catch (DbUpdateConcurrencyException)
        {
            if (!BerichtEintraegeExists(BerichtEintraege!.Id))
            {
                NavigationManager.NotFound();
            }
            else
            {
                throw;
            }
        }

        NavigationManager.NavigateTo("/BerichtEintraeges");
    }

    private bool BerichtEintraegeExists(int id)
    {
        using var context = DbFactory.CreateDbContext();
        return context.BerichtEintrag.Any(e => e.Id == id);
    }
}
