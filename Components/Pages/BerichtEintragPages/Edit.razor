@page "/berichteintrags/edit"
@using Microsoft.EntityFrameworkCore
@using xAzubiLog.Models
@inject IDbContextFactory<xAzubiLog.Data.xAzubiLogContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Edit</PageTitle>

<h1>Edit</h1>

<h2>BerichtEintrag</h2>
<hr />
@if (BerichtEintrag is null)
{
    <p><em>Loading...</em></p>
}
else
{
    <div class="row">
        <div class="col-md-4">
            <EditForm method="post" Model="BerichtEintrag" OnValidSubmit="UpdateBerichtEintrag" FormName="edit" Enhance>
                <DataAnnotationsValidator />
                <ValidationSummary role="alert"/>
                <input type="hidden" name="BerichtEintrag.Id" value="@BerichtEintrag.Id" />
                <div class="mb-3">
                    <label for="benutzerid" class="form-label">BenutzerId:</label>
                    <InputNumber id="benutzerid" @bind-Value="BerichtEintrag.BenutzerId" class="form-control" />
                    <ValidationMessage For="() => BerichtEintrag.BenutzerId" class="text-danger" />
                </div>
                <div class="mb-3">
                    <label for="ausbilderid" class="form-label">AusbilderId:</label>
                    <InputNumber id="ausbilderid" @bind-Value="BerichtEintrag.AusbilderId" class="form-control" />
                    <ValidationMessage For="() => BerichtEintrag.AusbilderId" class="text-danger" />
                </div>
                <div class="mb-3">
                    <label for="kategorieid" class="form-label">KategorieId:</label>
                    <InputNumber id="kategorieid" @bind-Value="BerichtEintrag.KategorieId" class="form-control" />
                    <ValidationMessage For="() => BerichtEintrag.KategorieId" class="text-danger" />
                </div>
                <div class="mb-3">
                    <label for="wochenberichtid" class="form-label">WochenberichtId:</label>
                    <InputNumber id="wochenberichtid" @bind-Value="BerichtEintrag.WochenberichtId" class="form-control" />
                    <ValidationMessage For="() => BerichtEintrag.WochenberichtId" class="text-danger" />
                </div>
                <div class="mb-3">
                    <label for="datum" class="form-label">Datum:</label>
                    <InputDate id="datum" @bind-Value="BerichtEintrag.Datum" class="form-control" />
                    <ValidationMessage For="() => BerichtEintrag.Datum" class="text-danger" />
                </div>
                <div class="mb-3">
                    <label for="tagestyp" class="form-label">Tagestyp:</label>
                    <InputText id="tagestyp" @bind-Value="BerichtEintrag.Tagestyp" class="form-control" />
                    <ValidationMessage For="() => BerichtEintrag.Tagestyp" class="text-danger" />
                </div>
                <div class="mb-3">
                    <label for="auftragsnummer" class="form-label">Auftragsnummer:</label>
                    <InputText id="auftragsnummer" @bind-Value="BerichtEintrag.Auftragsnummer" class="form-control" />
                    <ValidationMessage For="() => BerichtEintrag.Auftragsnummer" class="text-danger" />
                </div>
                <div class="mb-3">
                    <label for="titel" class="form-label">Titel:</label>
                    <InputText id="titel" @bind-Value="BerichtEintrag.Titel" class="form-control" />
                    <ValidationMessage For="() => BerichtEintrag.Titel" class="text-danger" />
                </div>
                <div class="mb-3">
                    <label for="beschreibung" class="form-label">Beschreibung:</label>
                    <InputText id="beschreibung" @bind-Value="BerichtEintrag.Beschreibung" class="form-control" />
                    <ValidationMessage For="() => BerichtEintrag.Beschreibung" class="text-danger" />
                </div>
                <div class="mb-3">
                    <label for="notiz" class="form-label">Notiz:</label>
                    <InputText id="notiz" @bind-Value="BerichtEintrag.Notiz" class="form-control" />
                    <ValidationMessage For="() => BerichtEintrag.Notiz" class="text-danger" />
                </div>
                <div class="mb-3">
                    <label for="fach" class="form-label">Fach:</label>
                    <InputText id="fach" @bind-Value="BerichtEintrag.Fach" class="form-control" />
                    <ValidationMessage For="() => BerichtEintrag.Fach" class="text-danger" />
                </div>
                <div class="mb-3">
                    <label for="startzeit" class="form-label">Startzeit:</label>
                    <InputDate id="startzeit" @bind-Value="BerichtEintrag.Startzeit" class="form-control" />
                    <ValidationMessage For="() => BerichtEintrag.Startzeit" class="text-danger" />
                </div>
                <div class="mb-3">
                    <label for="endzeit" class="form-label">Endzeit:</label>
                    <InputDate id="endzeit" @bind-Value="BerichtEintrag.Endzeit" class="form-control" />
                    <ValidationMessage For="() => BerichtEintrag.Endzeit" class="text-danger" />
                </div>
                <div class="mb-3">
                    <label for="dauer" class="form-label">Dauer:</label>
                    <InputNumber id="dauer" @bind-Value="BerichtEintrag.Dauer" class="form-control" />
                    <ValidationMessage For="() => BerichtEintrag.Dauer" class="text-danger" />
                </div>
                <div class="mb-3">
                    <label for="status" class="form-label">Status:</label>
                    <InputText id="status" @bind-Value="BerichtEintrag.Status" class="form-control" />
                    <ValidationMessage For="() => BerichtEintrag.Status" class="text-danger" />
                </div>
                <div class="mb-3">
                    <label for="erstelltam" class="form-label">ErstelltAm:</label>
                    <InputDate id="erstelltam" @bind-Value="BerichtEintrag.ErstelltAm" class="form-control" />
                    <ValidationMessage For="() => BerichtEintrag.ErstelltAm" class="text-danger" />
                </div>
                <div class="mb-3">
                    <label for="geändertam" class="form-label">GeändertAm:</label>
                    <InputDate id="geändertam" @bind-Value="BerichtEintrag.GeändertAm" class="form-control" />
                    <ValidationMessage For="() => BerichtEintrag.GeändertAm" class="text-danger" />
                </div>
                <button type="submit" class="btn btn-primary">Save</button>
            </EditForm>
        </div>
    </div>
}

<div>
    <a href="/berichteintrags">Back to List</a>
</div>

@code {
    [SupplyParameterFromQuery]
    private int Id { get; set; }

    [SupplyParameterFromForm]
    private BerichtEintrag? BerichtEintrag { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        BerichtEintrag ??= await context.BerichtEintrag.FirstOrDefaultAsync(m => m.Id == Id);

        if (BerichtEintrag is null)
        {
            NavigationManager.NotFound();
        }
    }

    // To protect from overposting attacks, enable the specific properties you want to bind to.
    // For more information, see https://learn.microsoft.com/aspnet/core/blazor/forms/#mitigate-overposting-attacks.
    private async Task UpdateBerichtEintrag()
    {
        using var context = DbFactory.CreateDbContext();
        context.Attach(BerichtEintrag!).State = EntityState.Modified;

        try
        {
            await context.SaveChangesAsync();
        }
        catch (DbUpdateConcurrencyException)
        {
            if (!BerichtEintragExists(BerichtEintrag!.Id))
            {
                NavigationManager.NotFound();
            }
            else
            {
                throw;
            }
        }

        NavigationManager.NavigateTo("/berichteintrags");
    }

    private bool BerichtEintragExists(int id)
    {
        using var context = DbFactory.CreateDbContext();
        return context.BerichtEintrag.Any(e => e.Id == id);
    }
}
