@page "/BerichtEintraeges/edit"
@using Microsoft.EntityFrameworkCore
@using xAzubiLog.Models
@inject IDbContextFactory<xAzubiLog.Data.xAzubiLogContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Edit</PageTitle>

<h1>Edit</h1>

<h2>BerichtEintraege</h2>
<hr />
@if (BerichtEintraege is null)
{
    <p><em>Loading...</em></p>
}
else
{
    <div class="row">
        <div class="col-md-4">
            <EditForm method="post" Model="BerichtEintraege" OnValidSubmit="UpdateBerichtEintraege" FormName="edit" Enhance>
                <DataAnnotationsValidator />
                <ValidationSummary role="alert"/>
                <input type="hidden" name="BerichtEintraege.Id" value="@BerichtEintraege.Id" />
                <div class="mb-3">
                    <label for="benutzerid" class="form-label">BenutzerId:</label>
                    <InputNumber id="benutzerid" @bind-Value="BerichtEintraege.BenutzerId" class="form-control" />
