@page "/dashboard"

<PageTitle>Übersicht - xAzubiLog</PageTitle>

<div class="container px-4 py-5 mt-3" style="max-width: 900px;">

    <!-- 1. Ruhige, professionelle Begrüßung (Klar und unaufgeregt) -->
    <header class="mb-5">
        <h1 class="fw-bold mb-2 text-white" style="font-size: 2.5rem; letter-spacing: -1px;">Guten Tag, Paul.</h1>
        <p class="fs-5" style="color: #a3a3a3;">Hier ist die Übersicht deiner Ausbildungsnachweise.</p>
    </header>

    <!-- 2. Sachlicher Aufgaben-Block (massiv, erdig, ohne harten Rand) -->
    <div class="p-4 p-md-5 mb-5 rounded-3" style="background-color: #362F2A;">
        <div class="row align-items-center">

            <div class="col-md-7 mb-4 mb-md-0">
                <h6 class="text-uppercase mb-4" style="color: #a3a3a3; font-size: 0.8rem; letter-spacing: 2px;">Aktuelle Aufgaben</h6>

                <div class="d-flex flex-column gap-3">
                    <!-- Roter Indikator: Fehlt komplett -->
                    <div class="d-flex align-items-center gap-3">
                        <span style="color: #ff4d4d; font-size: 0.75rem;">●</span>
                        <span class="text-white fw-medium">KW 17 <span style="color: #a3a3a3; font-weight: normal;">&mdash; Komplett fehlend</span></span>
                    </div>

                    <!-- Gelber Indikator: Unvollständig -->
                    <div class="d-flex align-items-center gap-3">
                        <span style="color: #ffc107; font-size: 0.75rem;">●</span>
                        <span class="text-white fw-medium">KW 18 <span style="color: #a3a3a3; font-weight: normal;">&mdash; Unvollständig (Donnerstag fehlt)</span></span>
                    </div>
                </div>
            </div>

            <div class="col-md-5 text-md-end">
                <a href="weekly" class="btn btn-light rounded-0 px-4 py-3 fw-bold w-100 text-uppercase shadow-none" style="font-size: 0.85rem; letter-spacing: 1px; color: #151515;">
                    Nachträge erfassen
                </a>
            </div>

        </div>
    </div>

    <!-- 3. Letzte Aktivitäten (Subtile Trennlinien im passenden Erdton) -->
    <div class="mt-5">
        <h6 class="text-uppercase mb-4" style="color: #a3a3a3; font-size: 0.8rem; letter-spacing: 2px;">Zuletzt eingereicht</h6>

        <div class="d-flex justify-content-between align-items-center border-bottom pb-3 mb-3" style="border-color: #362F2A !important;">
            <div>
                <span class="text-white fw-medium d-block">Wochenbericht KW 16</span>
                <span class="small" style="color: #a3a3a3;">Dienstag, 05.05.2026</span>
            </div>
            <span class="badge rounded-0 px-2 py-1 fw-normal" style="background-color: #151515; color: #a3a3a3; border: 1px solid #362F2A;">Genehmigt</span>
        </div>

        <div class="d-flex justify-content-between align-items-center border-bottom pb-3" style="border-color: #362F2A !important;">
            <div>
                <span class="text-white fw-medium d-block">Wochenbericht KW 15</span>
                <span class="small" style="color: #a3a3a3;">Freitag, 01.05.2026</span>
            </div>
            <span class="badge rounded-0 px-2 py-1 fw-normal" style="background-color: #151515; color: #a3a3a3; border: 1px solid #362F2A;">Genehmigt</span>
        </div>
    </div>

</div>