@page "/passwort-vergessen"

@using xAzubiLog.Data
@using xAzubiLog.Models
@using xAzubiLog.Services
@using Microsoft.EntityFrameworkCore

@inject AzubiLog_BlazorContext DB
@inject EmailService EmailService
@inject NavigationManager Nav

<PageTitle>Passwort vergessen – xAzubiLog</PageTitle>

<div class="login-wrapper">
    <div class="card">
        <div class="card2">

           <EditForm Model="this"
          FormName="PasswortVergessenForm"
          class="form"
          OnValidSubmit="PasswortVergessenAbsenden">
                <DataAnnotationsValidator />

                <p id="heading">xAzubiLog</p>

                @if (!string.IsNullOrEmpty(fehler))
                {
                    <div style="color:#ff6b6b; text-align:center; font-size:0.85rem;">
                        @fehler
                    </div>
                }

                @if (erfolg)
                {
                    <div style="color:#00ff75; text-align:center; font-size:0.85rem;">
                        E-Mail wurde gesendet! Prüfe dein Postfach.
                    </div>
                }

                <div class="field">
                    <input class="input-field"
                           type="email"
                           placeholder="E-Mail"
                           autocomplete="off"
                           @bind="email" />
                </div>

                <div class="btn">
                    <button class="button2"
                            type="button"
                            @onclick='() => Nav.NavigateTo("/login")'>
                        Zurück
                    </button>

                    <button class="button1"
                            type="submit">
                        Senden
                    </button>
                </div>
            </EditForm>

        </div>
    </div>
</div>

<style>
    .login-wrapper {
        display: flex;
        justify-content: center;
        align-items: center;
        height: 100vh;
        background: #171717;
    }

    .card {
        background-image: linear-gradient(163deg, #00ff75 0%, #3700ff 100%);
        border-radius: 22px;
        transition: all 0.3s;
    }

    .card2 {
        border-radius: 0;
        transition: all 0.2s;
    }

    .card2:hover {
        transform: scale(0.98);
        border-radius: 20px;
    }

    .card:hover {
        box-shadow: 0px 0px 30px 1px rgba(0, 255, 117, 0.3);
    }

    .form {
        display: flex;
        flex-direction: column;
        gap: 10px;
        padding: 2em;
        background-color: #171717;
        border-radius: 25px;
    }

    #heading {
        text-align: center;
        color: white;
        font-size: 1.2em;
    }

    .field {
        display: flex;
        align-items: center;
        gap: 0.5em;
        border-radius: 25px;
        padding: 0.6em;
        background-color: #171717;
        box-shadow: inset 2px 5px 10px rgb(5, 5, 5);
    }

    .input-field {
        background: none;
        border: none;
        outline: none;
        width: 100%;
        color: #d3d3d3;
    }

    .btn {
        display: flex;
        justify-content: center;
        gap: 0.5em;
        margin-top: 1.5em;
    }

    .button1, .button2 {
        padding: 0.5em 1.2em;
        border-radius: 5px;
        border: none;
        background-color: #252525;
        color: white;
        cursor: pointer;
    }

    .button1:hover, .button2:hover {
        background-color: black;
    }
</style>

@code {
    private string email = "";
    private string fehler = "";
    private bool erfolg = false;

    private async Task PasswortVergessenAbsenden()
    {
        Console.WriteLine("PASSWORT VERGESSEN BUTTON GEKLICKT");

        fehler = "";
        erfolg = false;

        if (string.IsNullOrWhiteSpace(email))
        {
            fehler = "Bitte eine E-Mail-Adresse eingeben.";
            return;
        }

        var user = await DB.Users
            .FirstOrDefaultAsync(u => u.Email == email);

        // Security: kein Hinweis, ob User existiert
        if (user == null)
        {
            erfolg = true;
            return;
        }

        var alterToken = await DB.PasswortResetTokens
            .FirstOrDefaultAsync(t =>
                t.UserId == user.ID &&
                t.Ablauf > DateTime.UtcNow);

        if (alterToken != null)
        {
            DB.PasswortResetTokens.Remove(alterToken);
        }

        var token = new PasswortResetToken
        {
            UserId = user.ID,
            Token = Guid.NewGuid().ToString("N"),
            Ablauf = DateTime.UtcNow.AddHours(1)
        };

        DB.PasswortResetTokens.Add(token);
        await DB.SaveChangesAsync();

        var resetLink = $"{Nav.BaseUri}passwort-reset?token={token.Token}";

        await EmailService.SendePasswortResetMail(user.Email, resetLink);

        erfolg = true;
    }
}