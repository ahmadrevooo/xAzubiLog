@page "/passwort-vergessen"
@rendermode InteractiveServer

@using xAzubiLog.Data
@using xAzubiLog.Models
@using xAzubiLog.Services
@using Microsoft.EntityFrameworkCore

@inject AzubiLog_BlazorContext DB
@inject NavigationManager Nav
@inject EmailService _emailService

<PageTitle>Passwort vergessen – xAzubiLog</PageTitle>

<div class="login-wrapper">
    <div class="card">
        <div class="card2">

            <div class="form">
                <p id="heading">xAzubiLog</p>

                @if (!string.IsNullOrEmpty(fehler))
                {
                    <div class="error-box">
                        @fehler
                    </div>
                }

                @if (erfolg)
                {
                    <div class="success-box">
                        E-Mail wurde gesendet! Prüfe dein Postfach.
                    </div>
                }

                <div class="field">
                    <InputText class="input-field"
           type="email"
           placeholder="E-Mail"
           autocomplete="off"
           @bind-Value="email" />

                </div>

                <div class="btn">
                    <button class="button2"
                            type="button"
                            @onclick='() => Nav.NavigateTo("/login")'>
                        Zurück
                    </button>

                    <button class="button1"
                            type="button"
                            @onclick="PasswortVergessenAbsenden"
                            disabled="@laden">
                        @(laden ? "Sende..." : "Senden")
                    </button>
                </div>
            </div>

        </div>
    </div>
</div>

<style>
    .login-wrapper {
        display: flex;
        justify-content: center;
        align-items: center;
        height: 100vh;
        background: #171717;
    }

    .card {
        background-image: linear-gradient(163deg, #00ff75 0%, #3700ff 100%);
        border-radius: 22px;
        padding: 2px;
    }

    .card2 {
        border-radius: 20px;
        background: #171717;
    }

    .form {
        display: flex;
        flex-direction: column;
        gap: 15px;
        padding: 2em;
        min-width: 320px;
    }

    #heading {
        text-align: center;
        color: white;
        font-size: 1.5rem;
        margin-bottom: 10px;
    }

    .field {
        display: flex;
        align-items: center;
        border-radius: 25px;
        padding: 0.8em;
        background-color: #171717;
        box-shadow: inset 2px 5px 10px rgb(5, 5, 5);
    }

    .input-field {
        background: none;
        border: none;
        outline: none;
        width: 100%;
        color: white;
        font-size: 1rem;
    }

    .btn {
        display: flex;
        justify-content: center;
        gap: 10px;
        margin-top: 10px;
    }

    .button1,
    .button2 {
        padding: 0.7em 1.4em;
        border-radius: 8px;
        border: none;
        background-color: #252525;
        color: white;
        cursor: pointer;
        transition: 0.2s;
    }

    .button1:hover,
    .button2:hover {
        background-color: #333;
    }

    .button1:disabled {
        opacity: 0.6;
        cursor: not-allowed;
    }

    .error-box {
        color: #ff6b6b;
        text-align: center;
        font-size: 0.9rem;
    }

    .success-box {
        color: #00ff75;
        text-align: center;
        font-size: 0.9rem;
    }
</style>

@code {

    private string email = "";
    private string fehler = "";
    private bool erfolg = false;
    private bool laden = false;

    private async Task PasswortVergessenAbsenden()
    {
        try
        {
            laden = true;

            Console.WriteLine($"EMAIL IST: '{email}'");

            fehler = "";
            erfolg = false;

            if (string.IsNullOrWhiteSpace(email))
            {
                fehler = "Bitte eine E-Mail-Adresse eingeben.";
                return;
            }

            var user = await DB.Users
    .FirstOrDefaultAsync(u =>
        u.Email.ToLower().Trim() == email.ToLower().Trim());

Console.WriteLine($"USER COUNT: {await DB.Users.CountAsync()}");

var allUsers = await DB.Users.ToListAsync();
foreach (var u in allUsers)
{
    Console.WriteLine($"DB EMAIL: '{u.Email}'");
}

Console.WriteLine($"USER FOUND: {user != null}");
Console.WriteLine($"EMAIL LENGTH: {email.Length}");
Console.WriteLine($"EMAIL BYTES: {string.Join(",", email.Select(c => (int)c))}");

            if (user == null)
            {
                erfolg = true;
                return;
            }

            var alterToken = await DB.PasswortResetTokens
                .FirstOrDefaultAsync(t =>
                    t.UserId == user.ID &&
                    t.Ablauf > DateTime.UtcNow);

            if (alterToken != null)
            {
                DB.PasswortResetTokens.Remove(alterToken);
            }

            var token = new PasswortResetToken
            {
                UserId = user.ID,
                Token = Guid.NewGuid().ToString("N"),
                Ablauf = DateTime.UtcNow.AddHours(1)
            };

            DB.PasswortResetTokens.Add(token);

            await DB.SaveChangesAsync();

                var resetLink =
    $"https://dyslexic-evil-stargazer.ngrok-free.dev/passwort-reset?token={token.Token}";

            Console.WriteLine("🔥 VOR EMAIL CALL");

            await _emailService.SendePasswortResetMail(
                user.Email,
                resetLink);

            Console.WriteLine("🔥 NACH EMAIL CALL");

            erfolg = true;
        }
        catch (Exception ex)
        {
            fehler = $"Fehler: {ex.Message}";
            Console.WriteLine(ex.ToString());
        }
        finally
        {
            laden = false;
        }
    }
}